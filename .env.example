# ---------------------------------------------------------------------------
# ZemaInspect — copy to .env.local and fill in. Never commit real values.
# ---------------------------------------------------------------------------

# Database (Neon). Use the POOLED connection string for DATABASE_URL and the
# DIRECT one for migrations — Prisma migrations fail over PgBouncer.
DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/zemainspect?sslmode=require"
DIRECT_DATABASE_URL="postgresql://user:pass@ep-xxx.region.aws.neon.tech/zemainspect?sslmode=require"

# Auth
NEXTAUTH_URL="https://zemainspect.vercel.app"
NEXTAUTH_SECRET=""                      # openssl rand -base64 32
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Magic-link email (optional; omit to run Google-only)
EMAIL_SERVER_HOST=""
EMAIL_SERVER_PORT="587"
EMAIL_SERVER_USER=""
EMAIL_SERVER_PASSWORD=""
EMAIL_FROM="ZemaInspect <no-reply@zemaai.com>"

# ---------------------------------------------------------------------------
# Billing — at least one provider must be configured for upgrades to work.
# Paystack is the default for NGN/African cards; Stripe covers everyone else.
# ---------------------------------------------------------------------------
PAYSTACK_SECRET_KEY=""                  # sk_live_… / sk_test_…
PAYSTACK_PUBLIC_KEY=""
PAYSTACK_PLAN_CODE_STARTER=""           # PLN_… created in the Paystack dashboard
PAYSTACK_PLAN_CODE_PRO=""

STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_ID_STARTER=""
STRIPE_PRICE_ID_PRO=""

# ---------------------------------------------------------------------------
# Model weights. Either commit public/models/yolov8n-neu.onnx, or host it and
# set MODEL_URL. See docs/MODEL.md.
# ---------------------------------------------------------------------------
MODEL_FILE="yolov8n-neu.onnx"
MODEL_URL=""                            # e.g. https://huggingface.co/<user>/zemainspect-neu/resolve/main/yolov8n-neu.onnx
MODEL_VARIANT="yolov8n-neu-onnx"
HUGGINGFACE_TOKEN=""                    # only needed for a private HF repo

# Optional Path B: GPU inference service for Pro/Enterprise accuracy
INFERENCE_SERVICE_URL=""
INFERENCE_SERVICE_API_KEY=""
INFERENCE_FORCE_EXTERNAL="false"

# Storage (optional — without it, frames are simply not retained)
BLOB_READ_WRITE_TOKEN=""

# Dynamic-content translation (optional; static UI strings need neither)
DEEPL_API_KEY=""
GOOGLE_TRANSLATE_API_KEY=""

# Compliance PDF in Chinese needs a CJK font; without it reports fall back to
# English rather than rendering unreadable boxes.
PDF_CJK_FONT_URL=""

# App
NEXT_PUBLIC_APP_URL="https://zemainspect.vercel.app"
ADMIN_EMAIL="emmanuel.ezeji@zemaai.com"  # seeded as SUPER_ADMIN on first login
CRON_SECRET=""                           # guards /api/cron/*
